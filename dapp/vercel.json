{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "dub1"
  ],
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- .",
  "crons": [
    {
      "path": "/api/cron/reverify",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/comp/payout",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/recap",
      "schedule": "0 7-11 * * 1"
    },
    {
      "path": "/api/cron/events",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/referrals",
      "schedule": "*/10 * * * *"
    }
  ]
}
